<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX 3.14 (candle/light). Build with installer\build-msi.cmd; it passes -dVersion, -dExePath, -dLicensePath,
     -dReadmePath, -dRtfPath and (only if the file exists) -dIconPath, all absolute. The defaults below assume
     the working directory is R\installer. -->
<?ifndef Version?><?define Version = "0.3.1"?><?endif?>
<?ifndef ExePath?><?define ExePath = "..\b\XMTray.exe"?><?endif?>
<?ifndef LicensePath?><?define LicensePath = "..\LICENSE"?><?endif?>
<?ifndef ReadmePath?><?define ReadmePath = "README.txt"?><?endif?>
<?ifndef RtfPath?><?define RtfPath = "License.rtf"?><?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- UpgradeCode is permanent. Never change it. -->
  <Product Id="*" Name="XMTray" Language="1033" Version="$(var.Version)"
           Manufacturer="XMTray (community, unofficial)"
           UpgradeCode="B66FE352-937B-4AF3-B995-E7ABD81B9BBB">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="XMTray - unofficial tray control for Sony Bluetooth headphones" />

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of XMTray is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <?ifdef IconPath?>
    <Icon Id="app.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <?endif?>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OMRITGM/XMTray" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="XMTray" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExe" Guid="E2E1A8B0-5C1F-4C7D-9B53-3A3E7F1D6A01" Win64="yes">
        <File Id="XMTrayExe" Name="XMTray.exe" Source="$(var.ExePath)" KeyPath="yes" />
      </Component>
      <Component Id="LicenseTxt" Guid="E2E1A8B0-5C1F-4C7D-9B53-3A3E7F1D6A02" Win64="yes">
        <File Id="LicenseTxtFile" Name="LICENSE.txt" Source="$(var.LicensePath)" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeTxt" Guid="E2E1A8B0-5C1F-4C7D-9B53-3A3E7F1D6A03" Win64="yes">
        <File Id="ReadmeTxtFile" Name="README.txt" Source="$(var.ReadmePath)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Standard WiX shortcut pattern: own component, HKCU KeyPath (ICE38/ICE43/ICE57). With ALLUSERS=1 the
         shortcut itself still lands in the all-users Start Menu. -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="E2E1A8B0-5C1F-4C7D-9B53-3A3E7F1D6A04">
        <Shortcut Id="StartMenuShortcut" Name="XMTray" Target="[#XMTrayExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\XMTray\Installer" Name="StartMenuShortcut" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Close a running instance before files are replaced/removed (uninstall and major upgrade).
         WM_CLOSE to its top-level windows; Terminate is the fallback. -->
    <util:CloseApplication Id="CloseXMTray" Target="XMTray.exe" CloseMessage="yes"
                           ElevatedCloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />

    <Feature Id="Main" Title="XMTray" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LicenseTxt" />
      <ComponentRef Id="ReadmeTxt" />
    </Feature>

    <!-- Autostart: XMTray writes HKCU\...\Run\XMTray itself, per user. A per-machine MSI cannot clean other
         users' hives (an HKCU component would break ICE38/ICE43 and only reach the installing admin).
         The dangling Run value is harmless; documented in README.txt. %LOCALAPPDATA%\XMTray is left alone. -->

    <WixVariable Id="WixUILicenseRtf" Value="$(var.RtfPath)" />

    <!-- Offer "Launch" only on install / upgrade, not on repair or remove. -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch XMTray" After="CostFinalize" Sequence="ui">NOT Installed</SetProperty>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#XMTrayExe]" />
    <CustomAction Id="LaunchXMTray" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <UIRef Id="WixUI_Minimal" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchXMTray" Order="999">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>
  </Product>
</Wix>
