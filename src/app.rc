#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Community build (unofficial)"
            VALUE "FileDescription", "XMTray - unofficial tray control for Sony headphones"
            VALUE "FileVersion", "0.3.0.0"
            VALUE "InternalName", "XMTray"
            VALUE "LegalCopyright", "MIT. Uses libmdr (c) mos9527 and contributors. Not affiliated with Sony."
            VALUE "OriginalFilename", "XMTray.exe"
            VALUE "ProductName", "XMTray"
            VALUE "ProductVersion", "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
