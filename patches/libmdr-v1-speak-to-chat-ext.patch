+        // Speak-to-Chat sensitivity, voice focus and timeout arrive as SYSTEM_RET/NTFY_EXTENDED_PARAM. Unread,
+        // every Speak-to-Chat commit writes their defaults back over the device's values.
+        // A reply that does not parse, or is not the TYPE_1 layout the commit writes, is skipped, as all of
+        // them were before this was dispatched.
+        int HandleSystemExParam(MDRHeadphones* self, Span<const UInt8> cmd)
+        {
+            SystemInquiredType type{};
+            if (!detail::ReadEnumTag(cmd, type) || type != SystemInquiredType::SMART_TALKING_MODE)
+                return MDR_EVENT_UNHANDLED;
+            const auto apply = [self](const auto& result) -> int
+            {
+                if (!result || result.value.detailSettingType != SmartTalkingModeDetailSettingType::TYPE_1)
+                    return MDR_EVENT_UNHANDLED;
+                self->mDetailsV1.mSpeakToChatDetectSensitivity.overwrite(result.value.devectionSensitivity);
+                self->mDetailsV1.mSpeakToChatVoiceFocus = result.value.voiceFocus;
+                self->mDetailsV1.mSpeakToModeOutTime.overwrite(result.value.modeOutTime);
+                return MDR_EVENT_SPEAK_TO_CHAT_CHANGED;
+            };
+            if (static_cast<Command>(cmd[0]) == Command::SYSTEM_NTFY_EXTENDED_PARAM)
+                return apply((NotifySystemExParamChildPayloadSmartTalkingModeExParamType1Param::Deserialize)(
+                    cmd.data(), cmd.size()));
+            return apply(
+                (RetSystemExParamChildPayloadSmartTalkingModeExParamType1Param::Deserialize)(cmd.data(), cmd.size()));
+        }
